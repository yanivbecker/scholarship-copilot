# Copy to api/.env and adjust. .env is git-ignored; never commit it.
# Where personal data lives (DB, files, backups). Must be outside this repo.
SCHOLARSHIP_DATA_DIR=~/ScholarshipCopilotData
# SCHOLARSHIP_PORT=8000

# --- AI (optional). "none" works without any AI (NFR-6). ---
# SCHOLARSHIP_AI_PROVIDER=none            # none | ollama | anthropic
# Anthropic: put your key here (never commit .env). Default model is
# claude-opus-5-5 ($4 / $20 per million input / output tokens).
# ANTHROPIC_API_KEY=
# SCHOLARSHIP_ANTHROPIC_MODEL=claude-opus-5-5
# SCHOLARSHIP_ANTHROPIC_EFFORT=medium     # low | medium | high
# Ollama (local, free): must be on this computer.
# SCHOLARSHIP_OLLAMA_URL=http://127.0.0.1:11434
# SCHOLARSHIP_OLLAMA_MODEL=llama3.1:8b
