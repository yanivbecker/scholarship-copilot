{
  "name": "scholarship-copilot-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fills scholarship forms from approved packets. Never submits (FR-X1, FR-X2).",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "jsdom": "31.0.1",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
